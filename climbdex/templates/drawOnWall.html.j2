<!DOCTYPE html>
<html>

<head>
    {% include 'head.html.j2'%}
    <style>
        #div-climb {
            overflow: auto;
        }
    </style>
</head>

<body>
    <div class="container-sm text-center">
        {% include 'heading.html.j2' %}
        <div class="row justify-content-md-center">
            <div class="col-md-5 card p-3 g-2" id="div-climb">
                <p class="mb-1">Setup: {{board.capitalize()}} - {{layout_name}} - {{size_name}}</p>
                <p class="mb-2"><small><a id="anchor-back">Back to setup selection</a></small></p>
                <div class="alert alert-warning py-2 small text-start" role="alert">
                    <strong>Experimental.</strong> Tap holds to colour them, then send them to the wall.
                    Needs a browser with Web Bluetooth (Chrome/Edge on desktop or Android; not iOS).
                    Close the official app first: the board accepts only one connection.
                </div>
                <svg id="svg-climb" viewbox="0 0 0 0" xmlns="http://www.w3.org/2000/svg"></svg>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div class="form-check form-switch text-start">
                        <input class="form-check-input" type="checkbox" role="switch" id="switch-live">
                        <label class="form-check-label" for="switch-live">Live: update wall on every tap</label>
                    </div>
                    <span id="span-status" class="badge text-bg-secondary">Not connected</span>
                </div>
                <div class="d-grid mt-3">
                    <button id="button-illuminate" class="btn btn-primary" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                            class="bi bi-lightbulb" viewBox="0 0 16 16">
                            <path
                                d="M2 6a6 6 0 1 1 10.174 4.31c-.203.196-.359.4-.453.619l-.762 1.769A.5.5 0 0 1 10.5 13a.5.5 0 0 1 0 1 .5.5 0 0 1 0 1l-.224.447a1 1 0 0 1-.894.553H6.618a1 1 0 0 1-.894-.553L5.5 15a.5.5 0 0 1 0-1 .5.5 0 0 1 0-1 .5.5 0 0 1-.46-.302l-.761-1.77a2 2 0 0 0-.453-.618A5.98 5.98 0 0 1 2 6m6-5a5 5 0 0 0-3.479 8.592c.263.254.514.564.676.941L5.83 12h4.342l.632-1.467c.162-.377.413-.687.676-.941A5 5 0 0 0 8 1" />
                        </svg>
                        Send to wall
                    </button>
                </div>
                <div class="row g-2 mt-1">
                    <div class="col d-grid">
                        <button class="btn btn-warning" type="button" id="button-reset-holds">Reset drawing</button>
                    </div>
                    <div class="col d-grid">
                        <button class="btn btn-outline-danger" type="button" id="button-clear-wall">Turn wall off</button>
                    </div>
                    <div class="col d-grid">
                        <button class="btn btn-outline-secondary" type="button" id="button-disconnect">Disconnect</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="row justify-content-md-center mt-3">
            {% include 'footer.html.j2' %}
        </div>
    </div>

    <script src="{{url_for('static', filename='js/common.js')}}"></script>
    <script src="{{url_for('static', filename='js/bluetooth.js')}}"></script>
    <script>
        const colors = {{ colors | tojson }};
        const ledColors = {{ led_colors | tojson }};
        const placementPositions = {{ placement_positions | tojson }};
    </script>
    <script src="{{url_for('static', filename='js/drawOnWall.js')}}"></script>
    <script>
        drawBoard('svg-climb', {{ images_to_holds | tojson }}, {{ edge_left }}, {{ edge_right }}, {{ edge_bottom }}, {{ edge_top }},
            (event) => onDrawCircleClick(event.target));
    </script>
</body>

</html>
